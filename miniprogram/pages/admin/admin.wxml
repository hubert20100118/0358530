<!-- pages/admin/admin.wxml -->
<view wx:if="{{!authed}}" class="card">
  <view class="hd">🔐 管理后台登录</view>
  <view class="field"><text class="lbl">后台密码</text><input class="inp" password value="{{pwd}}" bindinput="onPwd" placeholder="默认 admin123" /></view>
  <view class="btn" bindtap="doAuth">进入后台</view>
  <view class="muted" style="margin-top:16rpx">默认密码 admin123，可在「设置」中通过 Web 端修改。</view>
</view>

<block wx:else>
  <view class="stat-grid">
    <view class="stat"><view class="num">{{st.totalOrders}}</view><view class="lbl">总订单</view></view>
    <view class="stat"><view class="num">¥{{st.revenue}}</view><view class="lbl">总营收</view></view>
    <view class="stat"><view class="num">{{st.pending}}</view><view class="lbl">待处理</view></view>
    <view class="stat"><view class="num">{{st.users}}</view><view class="lbl">注册用户</view></view>
  </view>

  <view class="card">
    <view class="hd">📊 菜品销量 TOP</view>
    <view wx:if="{{dishRank.length === 0}}" class="muted">暂无订单数据</view>
    <view class="bar" wx:for="{{dishRank}}" wx:key="name">
      <text class="bname">{{item.name}}</text>
      <view class="btrack"><view class="bfill" style="width:{{item.pct}}%"></view></view>
      <text class="bval">{{item.qty}}</text>
    </view>
  </view>

  <view class="card">
    <view class="hd">⏰ 时段分布</view>
    <view class="bar" wx:for="{{slotRank}}" wx:key="slot">
      <text class="bname">{{item.slot}}</text>
      <view class="btrack"><view class="bfill" style="width:{{item.pct}}%"></view></view>
      <text class="bval">{{item.v}}</text>
    </view>
  </view>

  <view class="card">
    <view class="hd-row"><text class="hd">🍽️ 菜单管理</text><text class="btn sm" bindtap="openAddDish">+ 新增</text></view>
    <view class="li" wx:for="{{menu}}" wx:key="id">
      <view class="li-info">
        <image wx:if="{{item.image}}" class="thumb" src="{{item.image}}" mode="aspectFill" />
        <text wx:else class="thumb">{{item.emoji || '🍽️'}}</text>
        <text class="li-name">{{item.name}}</text> <text class="muted">{{item.category}} · ¥{{item.price}}{{item.available ? '' : ' · 售罄'}}</text>
      </view>
      <view><text class="btn sm ghost" data-id="{{item.id}}" bindtap="openEditDish">编辑</text> <text class="btn sm ghost danger" data-id="{{item.id}}" bindtap="delDish">删</text></view>
    </view>
  </view>

  <view class="card">
    <view class="hd-row"><text class="hd">👥 白名单 / 用户</text><text class="btn sm" bindtap="toggleWl">+ 加白名单</text></view>
    <view wx:if="{{wlForm.show}}" class="wl-form">
      <input class="inp" data-f="name" value="{{wlForm.name}}" bindinput="onWl" placeholder="姓名(可选)" />
      <input class="inp" data-f="phone" value="{{wlForm.phone}}" bindinput="onWl" placeholder="手机号" />
      <view class="btn sm" bindtap="addWl">添加</view>
    </view>
    <view class="li" wx:for="{{whitelist}}" wx:key="phone">
      <view class="li-info"><text class="li-name">{{item.phone}}</text> <text class="muted">{{item.name || ''}}</text> <text class="pill {{item.used ? 'used' : ''}}">{{item.used ? '已注册' : '待注册'}}</text></view>
      <text class="btn sm ghost danger" data-phone="{{item.phone}}" bindtap="delWl">删</text>
    </view>
    <view class="hd" style="margin-top:20rpx">已注册用户</view>
    <view class="li" wx:for="{{users}}" wx:key="id">
      <view class="li-info"><text class="li-name">{{item.name}}</text> <text class="muted">{{item.phone}}</text></view>
      <text class="pill">{{item.role}}</text>
    </view>
  </view>

  <view class="card">
    <view class="hd">🧾 全部订单</view>
    <view class="order" wx:for="{{orders}}" wx:key="id">
      <view class="o-hd"><text>{{item.userName}} · {{item.date}} {{item.slot}}</text><text class="tag {{item.status}}">{{item.statusText}}</text></view>
      <view class="muted">{{item.itemsText}}</view>
      <view class="o-ft">
        <text class="amt">¥{{item.totalPrice}}</text>
        <view>
          <text wx:if="{{item.status === 'pending'}}" class="btn sm" data-id="{{item.id}}" bindtap="doneOrder" style="margin-right:10rpx">完成</text>
          <text wx:if="{{item.status === 'pending'}}" class="btn sm ghost danger" data-id="{{item.id}}" bindtap="cancelOrder">取消</text>
          <text wx:if="{{item.status !== 'pending'}}" class="btn sm ghost danger" data-id="{{item.id}}" bindtap="delOrder">删除</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="hd">⚙️ 设置</view>
    <view class="field"><text class="lbl">店铺名称</text><input class="inp" data-f="setShop" value="{{setShop}}" bindinput="onSet" /></view>
    <view class="field"><text class="lbl">取餐时段（逗号分隔）</text><input class="inp" data-f="setSlots" value="{{setSlots}}" bindinput="onSet" /></view>
    <view class="btn" bindtap="saveSettings">保存设置</view>
    <view class="btn ghost danger" style="margin-top:16rpx" bindtap="resetAll">清空并重置演示数据</view>
  </view>
</block>

<!-- 菜品编辑弹层 -->
<view class="mask" wx:if="{{showDish}}" bindtap="closeDish">
  <view class="sheet" catchtap="noop">
    <view class="sheet-h">{{editId ? '编辑菜品' : '新增菜品'}}</view>
    <view class="field"><text class="lbl">名称</text><input class="inp" data-f="fName" value="{{fName}}" bindinput="onF" /></view>
    <view class="field"><text class="lbl">分类</text><input class="inp" data-f="fCat" value="{{fCat}}" bindinput="onF" placeholder="如 主食" /></view>
    <view class="field"><text class="lbl">价格(元)</text><input class="inp" type="digit" data-f="fPrice" value="{{fPrice}}" bindinput="onF" /></view>
    <view class="field"><text class="lbl">Emoji</text><input class="inp" data-f="fEmoji" value="{{fEmoji}}" bindinput="onF" /></view>
    <view class="field">
      <text class="lbl">菜品图片（自动压缩）</text>
      <view class="img-box">
        <image wx:if="{{fImg}}" class="img-preview" src="{{fImg}}" mode="aspectFill" />
        <view wx:else class="img-ph">未设置图片</view>
        <view class="btn sm" bindtap="chooseDishImage">{{fImg ? '重新选择' : '选择图片'}}</view>
      </view>
    </view>
    <view class="field"><text class="lbl">描述</text><input class="inp" data-f="fDesc" value="{{fDesc}}" bindinput="onF" /></view>
    <view class="field"><text class="lbl">在售</text><switch checked="{{fAvail}}" bindchange="onAvail" /></view>
    <view class="btn" bindtap="saveDish">保存</view>
    <view class="btn ghost" style="margin-top:16rpx" bindtap="closeDish">取消</view>
  </view>
</view>
