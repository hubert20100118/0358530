/* pages/admin/admin.wxss */
.stat-grid { display: flex; flex-wrap: wrap; padding: 0 12rpx; }
.stat { width: 50%; padding: 12rpx; box-sizing: border-box; }
.stat .num { font-size: 48rpx; font-weight: 800; color: #ff6b35; }
.stat .lbl { font-size: 22rpx; color: #8a8a8a; }
.hd { font-size: 30rpx; font-weight: 700; margin-bottom: 16rpx; }
.hd-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.bar { display: flex; align-items: center; margin-bottom: 14rpx; }
.bname { width: 150rpx; font-size: 24rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.btrack { flex: 1; height: 28rpx; background: #f3ece6; border-radius: 14rpx; overflow: hidden; margin: 0 14rpx; }
.bfill { height: 100%; background: #ff6b35; border-radius: 14rpx; }
.bval { width: 60rpx; text-align: right; font-size: 24rpx; color: #8a8a8a; }
.li { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0e6df; }
.li:last-child { border-bottom: none; }
.li-info { flex: 1; }
.li-name { font-weight: 600; margin-right: 10rpx; }
.thumb { width: 72rpx; height: 72rpx; border-radius: 12rpx; margin-right: 14rpx; flex: 0 0 auto; text-align: center; line-height: 72rpx; font-size: 40rpx; background: #f3ece6; }
.img-box { display: flex; align-items: center; gap: 20rpx; }
.img-preview { width: 140rpx; height: 140rpx; border-radius: 14rpx; }
.img-ph { width: 140rpx; height: 140rpx; border-radius: 14rpx; background: #f3ece6; color: #8a8a8a; font-size: 22rpx; display: flex; align-items: center; justify-content: center; }
.wl-form { background: #f6f1ee; padding: 20rpx; border-radius: 14rpx; margin-bottom: 16rpx; }
.wl-form .inp { background: #fff; margin-bottom: 14rpx; }
.order { padding: 18rpx 0; border-bottom: 1rpx solid #f0e6df; }
.order:last-child { border-bottom: none; }
.o-hd { display: flex; justify-content: space-between; align-items: center; font-weight: 600; font-size: 26rpx; }
.o-ft { display: flex; justify-content: space-between; align-items: center; margin-top: 10rpx; }
.amt { color: #ff6b35; font-weight: 700; }
.danger { color: #e23b3b; border: 1rpx solid #e23b3b; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 40; display: flex; align-items: flex-end; }
.sheet { background: #fff; width: 100%; border-radius: 28rpx 28rpx 0 0; padding: 30rpx 30rpx 50rpx; }
.sheet-h { font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; }
.field { margin-bottom: 18rpx; }
.lbl { font-size: 24rpx; color: #8a8a8a; display: block; margin-bottom: 10rpx; }
.inp { background: #f6f1ee; padding: 20rpx; border-radius: 14rpx; }
